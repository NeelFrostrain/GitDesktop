{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Desktop",
  "version": "0.1.0",
  "identifier": "com.cyronicstudio.gitdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["git-desktop", "gitlab-desktop"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IGF1dG8tdXBkYXRlciBwdWJsaWMga2V5Cg==",
      "endpoints": ["https://releases.gitdesktop.dev/{{target}}-{{arch}}/{{current_version}}"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": ["../bin/MinGit-2.47.1-64-bit.zip", "../bin/mingit/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
